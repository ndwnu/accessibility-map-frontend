{
  "name": "accessibility-map-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build --output-hashing all",
    "build:prod": "ng build --configuration production && npm run postbuild",
    "postbuild": "node scripts/replace-set-env.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:prod": "ng test --watch=false",
    "lint": "ng lint",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.7",
    "@angular/cdk": "21.2.6",
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/forms": "21.2.7",
    "@angular/platform-browser": "21.2.7",
    "@angular/platform-browser-dynamic": "21.2.7",
    "@angular/router": "21.2.7",
    "@ndwnu/core": "3.0.1",
    "@ndwnu/map": "1.0.1",
    "@ndwnu/design-system": "13.0.2",
    "@turf/bbox": "7.3.4",
    "@turf/helpers": "7.3.4",
    "maplibre-gl": "5.22.0",
    "rxjs": "7.8.2",
    "tslib": "2.3.0",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/build": "21.2.6",
    "@angular/cli": "21.2.6",
    "@angular/compiler-cli": "21.2.7",
    "@angular/localize": "21.2.7",
    "@eslint/js": "^10.0.1",
    "@total-typescript/ts-reset": "0.5.1",
    "@types/geojson": "^7946.0.16",
    "@types/jasmine": "5.1.2",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@typescript-eslint/types": "8.56.1",
    "@typescript-eslint/utils": "8.56.1",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.4.0",
    "jasmine-core": "5.1.1",
    "karma": "6.4.2",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
