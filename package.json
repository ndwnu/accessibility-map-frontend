{
  "name": "accessibility-map-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build --output-hashing all",
    "build:prod": "ng build --configuration production && npm run postbuild",
    "postbuild": "node scripts/replace-set-env.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:prod": "ng test --watch=false",
    "lint": "ng lint",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.14",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "20.3.14",
    "@angular/compiler": "20.3.14",
    "@angular/core": "20.3.14",
    "@angular/forms": "20.3.14",
    "@angular/platform-browser": "20.3.14",
    "@angular/platform-browser-dynamic": "20.3.14",
    "@angular/router": "20.3.14",
    "@ndwnu/core": "2.1.0",
    "@ndwnu/design-system": "12.2.0",
    "@ngneat/until-destroy": "10.0.0",
    "@popperjs/core": "2.11.8",
    "@turf/bbox": "6.5.0",
    "@turf/helpers": "^7.3.0",
    "bootstrap": "5.3.2",
    "boxicons": "^2.1.4",
    "geojson": "^0.5.0",
    "maplibre-gl": "5.13.0",
    "rxjs": "7.8.1",
    "tslib": "2.3.0",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/build": "^20.3.12",
    "@angular/cli": "20.3.12",
    "@angular/compiler-cli": "20.3.14",
    "@angular/localize": "20.3.14",
    "@total-typescript/ts-reset": "0.5.1",
    "@types/jasmine": "5.1.2",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@typescript-eslint/types": "^7.12.0",
    "@typescript-eslint/utils": "^8.48.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "jasmine-core": "5.1.1",
    "karma": "6.4.2",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3"
  }
}
